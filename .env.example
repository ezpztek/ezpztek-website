# Public contact details
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
SITE_URL=https://www.yourdomain.com

# Server-only security and Supabase settings
RATE_LIMIT_SECRET=replace_with_a_long_random_value
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace_with_your_server_secret_key
SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_key
ADMIN_EMERGENCY_PIN_HASH=scrypt:1ovKFxQfOIBtc94ztw2J5A:qXyho0MoyXZJRaR7Lt6t3bAozuhTJ_c5i8pf2DqZ5_fMyKsCwjLSRc-f-TgOR_gbQziScEOIFcoL5c3WjJLBDA
# Hostinger email settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@yourdomain.com
SMTP_PASS=replace_with_your_mailbox_password
SMTP_FROM_NAME=EZPZTEK
CONTACT_TO_EMAIL=hello@yourdomain.com

# EZPZTEK simulation only. No real foodpanda credentials are stored here.
DELIVERY_SANDBOX_ENABLED=false
# Generate distinct random secrets with at least 32 characters.
DELIVERY_SANDBOX_SECRET=
DELIVERY_WORKER_SECRET=

# Private inventory-image storage. Keep every value server-only.
AWS_REGION=ap-southeast-2
AWS_S3_INVENTORY_BUCKET=replace-with-your-private-bucket-name
# Production on Vercel: use OIDC instead of permanent AWS access keys.
AWS_ROLE_ARN=
